# Copy to .env and adjust. docker compose reads this automatically.

# HS256 signing key - MUST be at least 32 bytes and kept secret.
JWT_SECRET=sithiyama-local-development-signing-key-change-me-0123456789

# Database credentials used by docker-compose.yml
POSTGRES_DB=sithiyama
POSTGRES_USER=sithiyama
POSTGRES_PASSWORD=sithiyama
