# Copy to .env and adjust. docker compose reads this automatically.

# HS256 signing key - MUST be at least 32 bytes and kept secret.
JWT_SECRET=sithiyama-local-development-signing-key-change-me-0123456789

# Host port the PostGIS container is published on. Use 5433 by default so an
# already-installed PostgreSQL on 5432 does not conflict.
DB_PORT=5433

# Host port the API is published on (defaults to 8080).
API_PORT=8080

# Database credentials used by docker-compose.yml
POSTGRES_DB=sithiyama
POSTGRES_USER=sithiyama
POSTGRES_PASSWORD=sithiyama

# Optional Google AI Studio key for the Gemini route assistant.
# Without it, /api/v1/ai answers basic facts from the saved route data.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
